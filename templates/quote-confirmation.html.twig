<div class="max-w-3xl mx-auto mt-12 p-8 bg-white shadow-lg rounded-xl">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-green-600">Quote Generated Successfully</h1>
    <p class="mt-4 text-gray-600">Thank you. Your quotation has been generated and queued for email delivery.</p>
  </div>
  <div class="mt-8 border-t pt-6 grid grid-cols-2 gap-4">
    <div><strong>Quote ID:</strong></div><div>{{ quote.uuid }}</div>
    <div><strong>Name:</strong></div><div>{{ quote.name }}</div>
    <div><strong>Email:</strong></div><div>{{ quote.email }}</div>
    <div><strong>Total With GST:</strong></div><div class="font-bold text-lg text-blue-600">₹{{ quote.total_with_gst }}</div>
  </div>
  <div class="mt-10 text-center">
    <a href="/quote-download/{{ quote.uuid }}" class="inline-block px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition">Download PDF</a>
  </div>
</div>
