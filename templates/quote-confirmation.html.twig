<div class="max-w-3xl mx-auto mt-12 p-8 bg-white shadow-lg rounded-xl">
  <div class="text-center">
    <h1 class="text-3xl font-bold text-green-600">Quote Generated Successfully</h1>
    <p class="mt-4 text-gray-600">Thank you. Your quotation has been generated and queued for email delivery.</p>
  </div>
  <div class="mt-8 border-t pt-6 grid grid-cols-2 gap-4">
    <div><strong>Quote ID:</strong></div><div>{{ quote.uuid }}</div>
    <div><strong>Name:</strong></div><div>{{ quote.name }}</div>
    <div><strong>Email:</strong></div><div>{{ quote.email }}</div>
    <div><strong>Total With GST:</strong></div><div class="font-bold text-lg text-blue-600">₹{{ quote.total_with_gst }}</div>
  </div>
  {% set pdf_url = download_url|default(quote.download_url|default('/quote-download/' ~ quote.uuid)) %}
  <div class="mt-10 text-center" style="margin-top: 2.5rem; text-align: center;">
    <a
      href="{{ pdf_url }}"
      style="display: inline-flex; align-items: center; gap: 12px; padding: 15px 24px; border-radius: 999px; background: #ff4b00; color: #ffffff; font-weight: 700; text-decoration: none; box-shadow: 0 8px 18px rgba(255, 75, 0, 0.24);"
    >
      <span>Download PDF</span>
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <path d="M14 2v6h6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
        <path d="M12 12v5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        <path d="m9.5 14.5 2.5 2.5 2.5-2.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </a>
  </div>
</div>
